/// The archived species' egg must use the normal empty-hand pickup interaction.
/datum/unit_test/phoenix_egg_pickup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/phoenix_egg/egg = allocate(/obj/item/phoenix_egg)
	egg.attack_hand(user, list())
	TEST_ASSERT(user.is_holding(egg), "Clicking the egg with an empty hand must pick it up.")

/// The native adaptation window must expose its live research balance even before loading an egg.
/datum/unit_test/phoenix_adaptation_data/Run()
	var/obj/machinery/phoenix_research/station = allocate(/obj/machinery/phoenix_research)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/list/data = station.ui_data(user)
	TEST_ASSERT(isnum(data["points"]), "The adaptation window must expose the current shared research balance.")
	TEST_ASSERT_NULL(data["egg"], "An empty station must not display a nearby egg as loaded.")

/// Equip a real research ID while keeping both hands free for sample interactions.
/datum/unit_test/proc/phoenix_research_operator()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/card/id/advanced/card = allocate(/obj/item/card/id/advanced)
	card.access = list(ACCESS_RESEARCH)
	user.equip_to_slot(card, ITEM_SLOT_ID)
	return user

/// Native hand insertion, ejection and forced removal must preserve one sample and its trait ownership.
/datum/unit_test/phoenix_adaptation_loading/Run()
	var/mob/living/carbon/human/user = phoenix_research_operator()
	var/obj/machinery/phoenix_research/station = allocate(/obj/machinery/phoenix_research)
	var/obj/item/phoenix_egg/egg = allocate(/obj/item/phoenix_egg)
	egg.attack_hand(user, list())
	egg.melee_attack_chain(user, station)
	TEST_ASSERT_EQUAL(station.loaded_egg, egg, "Clicking the station with a held egg did not load that same physical item.")
	TEST_ASSERT_EQUAL(egg.loc, station, "Loading left the sample in the operator's inventory.")
	var/station_source = REF(station)
	TEST_ASSERT(HAS_TRAIT_FROM(egg, TRAIT_STASIS, station_source), "Loading did not suspend the egg for research.")
	egg.process(PHOENIX_EGG_SECONDS)
	TEST_ASSERT_EQUAL(egg.growth_seconds, 0, "A loaded sample kept incubating during research.")
	var/obj/item/phoenix_egg/other = allocate(/obj/item/phoenix_egg)
	other.attack_hand(user, list())
	other.melee_attack_chain(user, station)
	TEST_ASSERT_EQUAL(station.loaded_egg, egg, "A second insertion replaced the occupied sample.")
	TEST_ASSERT(user.is_holding(other), "A rejected second sample disappeared from the operator's hands.")
	egg.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT_NULL(station.loaded_egg, "An externally removed sample remained referenced by the station.")
	TEST_ASSERT(!HAS_TRAIT_FROM(egg, TRAIT_STASIS, station_source), "External removal left research stasis on the egg.")
	ADD_TRAIT(other, TRAIT_NODROP, "phoenix-test")
	other.melee_attack_chain(user, station)
	TEST_ASSERT_NULL(station.loaded_egg, "The station loaded an egg that could not leave the hand.")
	TEST_ASSERT(user.is_holding(other), "Failed unequipping lost the sample.")
	TEST_ASSERT(!HAS_TRAIT_FROM(other, TRAIT_STASIS, station_source), "Failed unequipping left research stasis on the held sample.")
	REMOVE_TRAIT(other, TRAIT_NODROP, "phoenix-test")
	var/obj/item/card/id/card = user.get_idcard()
	card.access = list()
	other.melee_attack_chain(user, station)
	TEST_ASSERT_NULL(station.loaded_egg, "An operator without research access loaded a sample.")
	card.access = list(ACCESS_RESEARCH)
	other.melee_attack_chain(user, station)
	TEST_ASSERT_EQUAL(station.loaded_egg, other, "The available sample could not be loaded after the obstruction was removed.")
	var/datum/tgui/ui = allocate(/datum/tgui, user, station, "PhoenixAdaptation")
	station.ui_act("eject", list("egg" = REF(egg)), ui, ui.state)
	TEST_ASSERT_EQUAL(station.loaded_egg, other, "A stale sample reference ejected the replacement egg.")
	ADD_TRAIT(other, TRAIT_STASIS, "phoenix-test-external")
	station.ui_act("eject", list("egg" = REF(other)), ui, ui.state)
	TEST_ASSERT_NULL(station.loaded_egg, "Native ejection retained the sample reference.")
	TEST_ASSERT(user.is_holding(other), "Native ejection did not return the egg to a free hand.")
	TEST_ASSERT(!HAS_TRAIT_FROM(other, TRAIT_STASIS, station_source), "Native ejection retained this station's stasis source.")
	TEST_ASSERT(HAS_TRAIT_FROM(other, TRAIT_STASIS, "phoenix-test-external"), "Native ejection removed an unrelated stasis source.")
	REMOVE_TRAIT(other, TRAIT_STASIS, "phoenix-test-external")
	other.melee_attack_chain(user, station)
	qdel(other)
	TEST_ASSERT_NULL(station.loaded_egg, "Deleting the contained sample left a stale reference.")
	egg.attack_hand(user, list())
	egg.melee_attack_chain(user, station)
	qdel(station)
	TEST_ASSERT(!QDELETED(egg), "Destroying the station destroyed its recoverable sample.")
	TEST_ASSERT(isturf(egg.loc), "Destroying the station failed to release its sample onto the floor.")
	TEST_ASSERT(!HAS_TRAIT_FROM(egg, TRAIT_STASIS, station_source), "A destroyed station kept the released egg suspended.")

/// Research actions spend the shared balance only on a successful current sample change.
/datum/unit_test/phoenix_adaptation_research/Run()
	var/mob/living/carbon/human/user = phoenix_research_operator()
	var/obj/machinery/phoenix_research/station = allocate(/obj/machinery/phoenix_research)
	var/datum/techweb/research = allocate(/datum/techweb)
	station.stored_research = research
	var/datum/phoenix_strain/parent_strain = allocate(/datum/phoenix_strain, "cold", FALSE)
	var/obj/item/phoenix_egg/egg = allocate(/obj/item/phoenix_egg, run_loc_floor_bottom_left, parent_strain, "adaptation-test", 1)
	egg.attack_hand(user, list())
	egg.melee_attack_chain(user, station)
	TEST_ASSERT_EQUAL(station.loaded_egg, egg, "The research fixture failed to load a held sample.")
	var/datum/tgui/ui = allocate(/datum/tgui, user, station, "PhoenixAdaptation")
	var/list/first_request = list("egg" = REF(egg), "adaptation" = "light", "expected_adaptations" = 0)
	research.adjust_points(TECHWEB_POINT_TYPE_GENERIC, PHOENIX_ADAPTATION_COST - 1)
	station.ui_act("adapt", first_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 0, "An unaffordable change altered the lineage.")
	TEST_ASSERT_EQUAL(research.research_points[TECHWEB_POINT_TYPE_GENERIC], PHOENIX_ADAPTATION_COST - 1, "A rejected change consumed research points.")
	research.adjust_points(TECHWEB_POINT_TYPE_GENERIC, PHOENIX_ADAPTATION_COST * 3 + 1)
	var/list/data = station.ui_data(user)
	TEST_ASSERT_EQUAL(data["points"], PHOENIX_ADAPTATION_COST * 4, "The live interface did not read the connected shared balance.")
	station.ui_act("adapt", first_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 1, "A funded research action did not change the loaded lineage.")
	TEST_ASSERT_EQUAL(parent_strain.adaptations, 0, "Research changed the parent profile instead of the egg's owned copy.")
	TEST_ASSERT_EQUAL(research.research_points[TECHWEB_POINT_TYPE_GENERIC], PHOENIX_ADAPTATION_COST * 3, "A successful change did not debit exactly one operation cost.")
	station.ui_act("adapt", first_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 1, "Replaying a stale request consumed another adaptation slot.")
	TEST_ASSERT_EQUAL(research.research_points[TECHWEB_POINT_TYPE_GENERIC], PHOENIX_ADAPTATION_COST * 3, "Replaying a stale request consumed more points.")
	var/list/second_request = list("egg" = REF(egg), "adaptation" = "allergy", "expected_adaptations" = 1)
	station.set_machine_stat(station.machine_stat | NOPOWER)
	station.ui_act("adapt", second_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 1, "An offline station applied a research action.")
	station.set_machine_stat(station.machine_stat & ~NOPOWER)
	user.forceMove(run_loc_floor_top_right)
	station.ui_act("adapt", second_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 1, "A distant actor researched through a stale window.")
	user.forceMove(run_loc_floor_bottom_left)
	var/obj/item/card/id/card = user.get_idcard()
	card.access = list()
	station.ui_act("adapt", second_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 1, "An operator without access researched through an open window.")
	card.access = list(ACCESS_RESEARCH)
	research.adjust_points(TECHWEB_POINT_TYPE_GENERIC, -PHOENIX_ADAPTATION_COST)
	data = station.ui_data(user)
	TEST_ASSERT_EQUAL(data["points"], PHOENIX_ADAPTATION_COST * 2, "Spending elsewhere in the shared techweb did not update the displayed balance.")
	station.ui_act("adapt", second_request, ui, ui.state)
	TEST_ASSERT_EQUAL(egg.strain.adaptations, 2, "The refreshed request did not use the line's remaining adaptation.")
	TEST_ASSERT_EQUAL(research.research_points[TECHWEB_POINT_TYPE_GENERIC], PHOENIX_ADAPTATION_COST, "The second successful change charged the wrong amount.")
	station.ui_act("eject", list("egg" = REF(egg)), ui, ui.state)
	user.dropItemToGround(egg)
	var/obj/item/phoenix_egg/offspring = allocate(/obj/item/phoenix_egg, run_loc_floor_bottom_left, egg.strain, "adaptation-test", 2)
	offspring.attack_hand(user, list())
	offspring.melee_attack_chain(user, station)
	station.ui_act("adapt", list("egg" = REF(offspring), "adaptation" = "yield", "expected_adaptations" = 2), ui, ui.state)
	TEST_ASSERT_EQUAL(offspring.strain.adaptations, 2, "Loading inherited offspring reset the line's adaptation cap.")
	TEST_ASSERT_EQUAL(research.research_points[TECHWEB_POINT_TYPE_GENERIC], PHOENIX_ADAPTATION_COST, "An exhausted inherited lineage consumed research points.")
