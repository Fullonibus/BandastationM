/datum/unit_test/spacepod_frame_geometry/Run()
	var/turf/start_turf = locate(run_loc_floor_bottom_left.x + 2, run_loc_floor_bottom_left.y + 2, run_loc_floor_bottom_left.z)
	var/list/part_types = list(
		/obj/item/pod_parts/pod_frame/aft_port,
		/obj/item/pod_parts/pod_frame/fore_port,
		/obj/item/pod_parts/pod_frame/fore_starboard,
		/obj/item/pod_parts/pod_frame/aft_starboard,
	)
	for(var/facing in GLOB.cardinals)
		var/list/parts = list()
		var/turf/part_turf = start_turf
		for(var/part_type in part_types)
			var/obj/item/pod_parts/pod_frame/part = allocate(part_type, part_turf)
			part.setDir(facing)
			part.set_anchored(TRUE)
			part.set_density(TRUE)
			parts += part
			part_turf = get_step(part, turn(facing, -part.link_angle))
		TEST_ASSERT_EQUAL(part_turf, start_turf, "The four frame parts must form a closed square at every cardinal facing.")
		for(var/obj/item/pod_parts/pod_frame/part as anything in parts)
			TEST_ASSERT_EQUAL(length(part.find_square()), 4, "Every corner must recognize the complete square at facing [facing].")
		var/obj/item/pod_parts/pod_frame/first_part = parts[1]
		var/obj/item/pod_parts/pod_frame/second_part = parts[2]
		second_part.set_anchored(FALSE)
		TEST_ASSERT_NULL(first_part.find_square(), "An unanchored corner must prevent assembly.")
		second_part.set_anchored(TRUE)
		second_part.setDir(turn(facing, 90))
		TEST_ASSERT_NULL(first_part.find_square(), "A differently oriented corner must prevent assembly.")
		second_part.setDir(facing)
		var/turf/missing_part_turf = second_part.loc
		qdel(second_part)
		var/obj/item/pod_parts/pod_frame/duplicate_part = allocate(/obj/item/pod_parts/pod_frame/aft_port, missing_part_turf)
		duplicate_part.setDir(facing)
		duplicate_part.set_anchored(TRUE)
		TEST_ASSERT_NULL(first_part.find_square(), "A duplicate part type must not substitute for a missing corner.")
		qdel(duplicate_part)
		QDEL_LIST(parts)

/datum/unit_test/spacepod_frame_assembly/Run()
	var/turf/anchor_turf = get_step(run_loc_floor_bottom_left, NORTHEAST)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent, get_step(anchor_turf, WEST))
	var/obj/item/pod_parts/pod_frame/aft_port/aft_port = allocate(/obj/item/pod_parts/pod_frame/aft_port, anchor_turf)
	var/obj/item/pod_parts/pod_frame/fore_port/fore_port = allocate(/obj/item/pod_parts/pod_frame/fore_port, get_step(anchor_turf, NORTH))
	var/obj/item/pod_parts/pod_frame/fore_starboard/fore_starboard = allocate(/obj/item/pod_parts/pod_frame/fore_starboard, get_step(anchor_turf, NORTHEAST))
	var/obj/item/pod_parts/pod_frame/aft_starboard/aft_starboard = allocate(/obj/item/pod_parts/pod_frame/aft_starboard, get_step(anchor_turf, EAST))
	var/list/parts = list(aft_port, fore_port, fore_starboard, aft_starboard)
	for(var/obj/item/pod_parts/pod_frame/part as anything in parts)
		part.setDir(NORTH)
		part.set_anchored(TRUE)
		part.set_density(TRUE)
	var/obj/item/stack/rods/rods = allocate(/obj/item/stack/rods, user, 9, FALSE)
	user.put_in_active_hand(rods, forced = TRUE)
	TEST_ASSERT(aft_port.item_interaction(user, rods, list()) & ITEM_INTERACT_BLOCKING, "Nine rods must not build a chassis.")
	TEST_ASSERT_EQUAL(rods.get_amount(), 9, "A failed assembly must not consume any rods.")
	TEST_ASSERT_EQUAL(length(aft_port.find_square()), 4, "A failed assembly must preserve all corners.")
	rods.add(1)
	var/obj/structure/closet/crate/blocker = allocate(/obj/structure/closet/crate, fore_port.loc)
	TEST_ASSERT(aft_port.item_interaction(user, rods, list()) & ITEM_INTERACT_BLOCKING, "A blocked corner must prevent assembly.")
	TEST_ASSERT_EQUAL(rods.get_amount(), 10, "A blocked assembly must not consume rods.")
	qdel(blocker)
	TEST_ASSERT(aft_port.item_interaction(user, rods, list()) & ITEM_INTERACT_SUCCESS, "Four valid corners and ten rods must build the chassis.")
	for(var/obj/item/pod_parts/pod_frame/part as anything in parts)
		TEST_ASSERT(QDELETED(part), "All four frame parts must be consumed exactly once.")
	TEST_ASSERT(QDELETED(rods), "The ten-rod stack must be fully consumed.")
	var/obj/structure/spacepod_frame/chassis = locate() in anchor_turf
	TEST_ASSERT_NOTNULL(chassis, "The chassis must use the southwest corner of the 2x2 footprint.")
	TEST_ASSERT_EQUAL(chassis.dir, EAST, "Construction sprites have a fixed east-facing orientation.")

/datum/unit_test/spacepod_construction_perimeter
	parent_type = /datum/unit_test/spacepod_vacuum

/// Real construction clicks must work around the whole chassis without reaching through barriers.
/datum/unit_test/spacepod_construction_perimeter/Run()
	TEST_ASSERT_NOTNULL(vacuum_origin, "Could not reserve the chassis interaction enclosure.")
	var/obj/structure/spacepod_frame/chassis = allocate(__IMPLIED_TYPE__, vacuum_origin)
	var/datum/component/construction/spacepod/construction = chassis.GetComponent(/datum/component/construction/spacepod)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(vacuum_origin, SOUTHWEST))
	user.mock_client = allocate(/datum/client_interface)
	user.set_combat_mode(FALSE)
	var/obj/item/stack/cable_coil/cable = allocate(__IMPLIED_TYPE__, user, 4, FALSE)
	TEST_ASSERT(user.put_in_active_hand(cable), "Could not equip the chassis wiring.")
	click_wrapper(user, chassis)
	TEST_ASSERT_EQUAL(construction.index, 2, "The initial real cable click did not wire the chassis.")
	var/obj/item/screwdriver/screwdriver = allocate(__IMPLIED_TYPE__, user)
	TEST_ASSERT(user.put_in_active_hand(screwdriver), "Could not equip the construction screwdriver.")
	var/list/perimeter = list(list(2, 2), list(1, 2), list(0, 2), list(-1, 2), list(2, 1), list(2, 0), list(2, -1), list(1, -1), list(0, -1), list(-1, -1), list(-1, 0), list(-1, 1))
	for(var/list/offset as anything in perimeter)
		user.forceMove(locate(vacuum_origin.x + offset[1], vacuum_origin.y + offset[2], vacuum_origin.z))
		click_wrapper(user, chassis)
		TEST_ASSERT_EQUAL(construction.index, 3, "Construction failed from chassis offset ([offset[1]],[offset[2]]).")
		click_wrapper(user, chassis)
		TEST_ASSERT_EQUAL(construction.index, 2, "Reverse construction failed from the same chassis edge.")
	for(var/list/offset as anything in list(list(3, 1), list(1, 3)))
		user.forceMove(locate(vacuum_origin.x + offset[1], vacuum_origin.y + offset[2], vacuum_origin.z))
		click_wrapper(user, chassis)
		TEST_ASSERT_EQUAL(construction.index, 2, "Construction reached beyond the chassis perimeter.")
	TEST_ASSERT(run_loc_floor_bottom_left.z != vacuum_origin.z, "The cross-Z control is not on a separate level.")
	user.forceMove(run_loc_floor_bottom_left)
	click_wrapper(user, chassis)
	TEST_ASSERT_EQUAL(construction.index, 2, "Construction reached a chassis on another Z level.")
	user.forceMove(locate(vacuum_origin.x + 2, vacuum_origin.y + 1, vacuum_origin.z))
	var/obj/structure/window/lower_window = allocate(__IMPLIED_TYPE__, locate(vacuum_origin.x + 1, vacuum_origin.y, vacuum_origin.z))
	var/obj/structure/window/upper_window = allocate(__IMPLIED_TYPE__, locate(vacuum_origin.x + 1, vacuum_origin.y + 1, vacuum_origin.z))
	lower_window.setDir(EAST)
	upper_window.setDir(EAST)
	click_wrapper(user, chassis)
	TEST_ASSERT_EQUAL(construction.index, 2, "Construction crossed a complete window barrier.")
	qdel(upper_window)
	click_wrapper(user, chassis)
	TEST_ASSERT_EQUAL(construction.index, 3, "Removing the nearer window did not restore construction access.")

/datum/unit_test/spacepod_construction_roundtrip/proc/use_item(obj/structure/spacepod_frame/chassis, mob/living/carbon/human/user, obj/item/used_item)
	var/obj/item/old_item = user.get_active_held_item()
	if(old_item != used_item)
		if(old_item)
			user.dropItemToGround(old_item)
		user.put_in_active_hand(used_item, forced = TRUE)
	return chassis.attackby(used_item, user, list(), list())

/datum/unit_test/spacepod_construction_roundtrip/Run()
	var/turf/chassis_turf = get_step(run_loc_floor_bottom_left, NORTHEAST)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent, get_step(chassis_turf, WEST))
	var/obj/structure/spacepod_frame/chassis = allocate(/obj/structure/spacepod_frame, chassis_turf)
	var/datum/component/construction/spacepod/construction = chassis.GetComponent(/datum/component/construction/spacepod)
	TEST_ASSERT_NOTNULL(construction, "Every chassis must have its construction component.")
	var/list/states = icon_states_fast(chassis.icon)
	for(var/list/step as anything in construction.steps)
		TEST_ASSERT(step["icon_state"] in states, "All twelve construction stages must have a real sprite.")
	var/obj/item/stack/cable_coil/cable = allocate(/obj/item/stack/cable_coil, user, 8, FALSE)
	var/obj/item/stack/sheet/iron/iron = allocate(/obj/item/stack/sheet/iron, user, 10, FALSE)
	var/obj/item/circuitboard/mecha/pod/board = allocate(/obj/item/circuitboard/mecha/pod, user)
	var/obj/item/pod_parts/core/core = allocate(/obj/item/pod_parts/core, user)
	var/obj/item/pod_parts/armor/armor = allocate(/obj/item/pod_parts/armor, user)
	var/obj/item/screwdriver/screwdriver = allocate(/obj/item/screwdriver, user)
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench, user)
	var/obj/item/crowbar/crowbar = allocate(/obj/item/crowbar, user)
	var/obj/item/wirecutters/wirecutters = allocate(/obj/item/wirecutters, user)
	var/obj/item/weldingtool/welder = allocate(/obj/item/weldingtool, user)
	use_item(chassis, user, screwdriver)
	TEST_ASSERT_EQUAL(construction.index, 1, "The wrong tool must not advance construction.")
	use_item(chassis, user, cable)
	TEST_ASSERT_EQUAL(construction.index, 2, "The native attackby signal must advance construction.")
	TEST_ASSERT_EQUAL(cable.get_amount(), 4, "The wiring stage must consume four cable pieces.")
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, board)
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, core)
	use_item(chassis, user, wrench)
	use_item(chassis, user, iron)
	TEST_ASSERT_EQUAL(construction.index, 8, "Installing the bulkhead must reach stage eight.")
	TEST_ASSERT_EQUAL(iron.get_amount(), 5, "The bulkhead must consume five iron sheets.")
	use_item(chassis, user, wrench)
	TEST_ASSERT(use_item(chassis, user, welder), "Recognized welding construction must stop the damage attack chain even if the welder is unlit.")
	TEST_ASSERT_EQUAL(construction.index, 9, "An unlit welder must not advance construction.")
	welder.attack_self(user)
	use_item(chassis, user, welder)
	use_item(chassis, user, armor)
	use_item(chassis, user, wrench)
	TEST_ASSERT_EQUAL(construction.index, 12, "All installed parts must reach the last welding step.")
	TEST_ASSERT_EQUAL(board.loc, chassis, "The original board must stay inside the chassis until completion or removal.")
	TEST_ASSERT_EQUAL(core.loc, chassis, "The original core must stay inside the chassis.")
	TEST_ASSERT_EQUAL(armor.loc, chassis, "The original armor must stay inside the chassis.")
	use_item(chassis, user, wrench)
	use_item(chassis, user, crowbar)
	TEST_ASSERT_EQUAL(armor.loc, chassis_turf, "Removing armor must return the same object.")
	use_item(chassis, user, welder)
	use_item(chassis, user, wrench)
	use_item(chassis, user, crowbar)
	var/obj/item/stack/sheet/iron/refunded_iron = locate() in chassis_turf
	TEST_ASSERT_NOTNULL(refunded_iron, "Removing the bulkhead must refund iron sheets.")
	TEST_ASSERT_EQUAL(refunded_iron.get_amount(), 5, "Removing the bulkhead must refund exactly five iron sheets.")
	use_item(chassis, user, wrench)
	use_item(chassis, user, crowbar)
	TEST_ASSERT_EQUAL(core.loc, chassis_turf, "Removing the core must return the original object.")
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, crowbar)
	TEST_ASSERT_EQUAL(board.loc, chassis_turf, "Removing the board must return the original object.")
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, wirecutters)
	TEST_ASSERT_EQUAL(construction.index, 1, "The whole construction must be reversible to the empty frame.")
	TEST_ASSERT_NULL(locate(/obj/item/stack/cable_coil) in chassis_turf, "Cut wiring is not refunded in the donor construction.")
	use_item(chassis, user, crowbar)
	TEST_ASSERT_EQUAL(construction.index, 1, "An extra removal attempt must not change the empty frame.")
	TEST_ASSERT_EQUAL(refunded_iron.get_amount(), 5, "Repeated removal must not duplicate refunded materials.")
	user.set_combat_mode(TRUE)
	use_item(chassis, user, cable)
	TEST_ASSERT_EQUAL(construction.index, 1, "Combat attacks must not perform construction steps.")
	TEST_ASSERT_EQUAL(cable.get_amount(), 4, "Rejected combat construction must not consume cable.")
	user.set_combat_mode(FALSE)
	use_item(chassis, user, cable)
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, board)
	use_item(chassis, user, screwdriver)
	use_item(chassis, user, core)
	use_item(chassis, user, wrench)
	use_item(chassis, user, refunded_iron)
	use_item(chassis, user, wrench)
	use_item(chassis, user, welder)
	use_item(chassis, user, armor)
	use_item(chassis, user, wrench)
	TEST_ASSERT(use_item(chassis, user, welder), "The final construction action must stop the attack chain after deleting the chassis.")
	TEST_ASSERT(QDELETED(chassis), "Completing the final weld must delete the construction frame.")
	var/pod_count = 0
	for(var/obj/vehicle/sealed/spacepod/civilian/pod in chassis_turf)
		pod_count++
	TEST_ASSERT_EQUAL(pod_count, 1, "Completing all twelve stages must produce exactly one civilian pod.")
