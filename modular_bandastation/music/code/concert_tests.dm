/** Real uploads are profession-guarded and survive replacement of their player. */
/datum/unit_test/concert_disk_recording/Run()
	var/mob/living/carbon/human/consistent/artist = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	artist.mind_initialize()
	var/datum/job/musician = allocate(/datum/job/donor/musician)
	var/obj/machinery/concert_player/first = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	first.set_is_operational(TRUE)
	var/obj/item/concert_disk/disk = allocate(/obj/item/concert_disk, run_loc_floor_bottom_left)
	if(!(artist.put_in_active_hand(disk)))
		return Fail("Could not hold the blank disk.", __FILE__, __LINE__)
	if(!(first.insert_disk(disk, artist)))
		return Fail("Could not insert the blank disk.", __FILE__, __LINE__)
	if(!(!disk.record_track('sound/items/bikehorn.ogg', artist, first)))
		return Fail("A non-Musician recorded a disk.", __FILE__, __LINE__)
	artist.mind.assigned_role = musician
	if(!(disk.record_track('sound/items/bikehorn.ogg', artist, first)))
		return Fail("Musician's valid OGG was not recorded.", __FILE__, __LINE__)
	var/datum/track/concert_recording/track = disk.tracks[1]
	var/path = track.upload_path
	if(!(fexists(path) && track.song_length > 0))
		return Fail("The committed recording has no readable backing file or duration.", __FILE__, __LINE__)
	artist.mind.assigned_role = null
	if(!(!disk.edit_track("remove", track, null, artist, first)))
		return Fail("A non-Musician erased a recorded disk.", __FILE__, __LINE__)
	if(!(!disk.edit_track("rename", track, "Forbidden", artist, first)))
		return Fail("A non-Musician renamed a recording.", __FILE__, __LINE__)
	first.eject_disk(artist)
	qdel(first)
	if(!(fexists(path)))
		return Fail("Deleting the first player deleted a disk-owned recording.", __FILE__, __LINE__)
	var/obj/machinery/concert_player/second = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	second.set_is_operational(TRUE)
	if(!(second.insert_disk(disk, artist)))
		return Fail("Could not transfer the recorded disk into a new player.", __FILE__, __LINE__)
	var/datum/component/shell/player_shell = second.GetComponent(/datum/component/shell)
	var/obj/item/integrated_circuit/board = allocate(/obj/item/integrated_circuit, run_loc_floor_bottom_left)
	board.cell = allocate(/obj/item/stock_parts/power_store/cell/high, board)
	var/obj/item/circuit_component/concert_master/master = allocate(/obj/item/circuit_component/concert_master, run_loc_floor_bottom_left)
	board.add_component_manually(master)
	player_shell.attach_circuit(board)
	master.start.set_input(COMPONENT_SIGNAL)
	if(!second.song.playing || !master.is_playing.value)
		return Fail("Public circuit playback failed or did not publish its playing state.", __FILE__, __LINE__)
	if(!(second.song.file_track == track.song_path))
		return Fail("The new player did not play the disk's own recording.", __FILE__, __LINE__)
	if(!(second.song.using_sound_channels == 1))
		return Fail("Concert playback did not allocate exactly one channel.", __FILE__, __LINE__)
	second.eject_disk(artist)
	if(!(!second.song.playing && !second.song.using_sound_channels))
		return Fail("Ejection left playback or a channel allocated.", __FILE__, __LINE__)
	if(!(fexists(path)))
		return Fail("Ejection deleted the recording.", __FILE__, __LINE__)
	qdel(disk)
	if(!(!fexists(path)))
		return Fail("Destroying the disk leaked its backing file.", __FILE__, __LINE__)

/** A recording in flight must not follow a disk to another player. */
/datum/unit_test/concert_disk_custody/Run()
	var/mob/living/carbon/human/consistent/artist = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	artist.mind_initialize()
	artist.mind.assigned_role = allocate(/datum/job/donor/musician)
	var/obj/machinery/concert_player/first = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	var/obj/machinery/concert_player/second = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	first.set_is_operational(TRUE)
	second.set_is_operational(TRUE)
	var/obj/item/concert_disk/disk = allocate(/obj/item/concert_disk, run_loc_floor_bottom_left)
	if(!(artist.put_in_active_hand(disk)))
		return Fail("Could not hold the disk.", __FILE__, __LINE__)
	if(!(first.insert_disk(disk, artist)))
		return Fail("Could not insert the disk.", __FILE__, __LINE__)
	first.eject_disk(artist)
	if(!(second.insert_disk(disk, artist)))
		return Fail("Could not move the disk to another player.", __FILE__, __LINE__)
	if(!(!disk.record_track('sound/items/bikehorn.ogg', artist, first)))
		return Fail("An old upload target wrote to the newly inserted disk.", __FILE__, __LINE__)
	if(!(length(disk.tracks) == 0))
		return Fail("Rejected recording changed the disk.", __FILE__, __LINE__)
	if(!(disk.record_track('sound/items/bikehorn.ogg', artist, second)))
		return Fail("Current physical player could not record.", __FILE__, __LINE__)
	if(!(second.play_music()))
		return Fail("The recorded disk did not start.", __FILE__, __LINE__)
	disk.forceMove(run_loc_floor_bottom_left)
	if(!(!second.inserted_disk && !second.selected_track && !second.song.playing && !second.song.using_sound_channels))
		return Fail("Forced disk removal retained borrowed data or playback.", __FILE__, __LINE__)
	if(!artist.put_in_active_hand(disk) || !second.insert_disk(disk, artist))
		return Fail("Could not reinsert the disk after forced removal.", __FILE__, __LINE__)
	second.song.start_playing(second)
	if(!second.song.playing || second.song.playback_mode != "file")
		return Fail("Reinserting a disk left concert playback in the Notes engine.", __FILE__, __LINE__)
	var/datum/track/concert_recording/track = disk.tracks[1]
	var/path = track.upload_path
	if(!disk.edit_track("remove", track, null, artist, second))
		return Fail("The Musician could not erase the selected recording.", __FILE__, __LINE__)
	if(second.song.playing || second.song.using_sound_channels || second.song.file_track || length(disk.tracks) || disk.used_bytes || fexists(path))
		return Fail("Erasing a selected recording retained audio, disk bytes or the backing file.", __FILE__, __LINE__)

/** Real remote ownership and master installation must govern external stage audio. */
/datum/unit_test/concert_stage_circuits/Run()
	var/mob/living/carbon/human/consistent/builder = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/obj/machinery/concert_player/player = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	player.set_is_operational(TRUE)
	var/datum/component/shell/player_shell = player.GetComponent(/datum/component/shell)
	var/obj/item/integrated_circuit/master_board = allocate(/obj/item/integrated_circuit, run_loc_floor_bottom_left)
	master_board.cell = allocate(/obj/item/stock_parts/power_store/cell/high, master_board)
	var/obj/item/circuit_component/concert_master/master = allocate(/obj/item/circuit_component/concert_master, run_loc_floor_bottom_left)
	var/obj/item/concert_remote/remote = master.remote
	if(remote.loc != master || !builder.put_in_active_hand(master))
		return Fail("The supplied master did not own its physical remote.", __FILE__, __LINE__)
	master.attack_self(builder)
	if(remote.loc != run_loc_floor_bottom_left)
		return Fail("Extracting the remote while holding its master did not drop it into reach.", __FILE__, __LINE__)
	if(!master_board.add_component_manually(master, builder) || !builder.put_in_active_hand(remote))
		return Fail("Could not install the master and pick up its extracted remote.", __FILE__, __LINE__)
	player_shell.attach_circuit(master_board)
	var/obj/structure/concertspeaker/speaker = allocate(/obj/structure/concertspeaker, run_loc_floor_bottom_left)
	var/datum/component/shell/speaker_shell = speaker.GetComponent(/datum/component/shell)
	var/obj/item/integrated_circuit/board = allocate(/obj/item/integrated_circuit, run_loc_floor_bottom_left)
	board.cell = allocate(/obj/item/stock_parts/power_store/cell/high, board)
	speaker_shell.attach_circuit(board)
	remote.interact_with_atom(board, builder, list())
	var/obj/item/circuit_component/concert_listener/receiver = locate() in board.attached_components
	if(!receiver || !(receiver in remote.receivers))
		return Fail("The remote did not create and own a receiver in the selected integrated circuit.", __FILE__, __LINE__)
	if(speaker in player.song.get_instrument_sources())
		return Fail("An unsecured speaker emitted stage audio.", __FILE__, __LINE__)
	speaker.set_anchored(TRUE)
	if(!(speaker in player.song.get_instrument_sources()))
		return Fail("Securing a linked speaker did not activate its source.", __FILE__, __LINE__)
	board.set_locked(TRUE)
	remote.interact_with_atom(board, builder, list())
	if(QDELETED(receiver) || !(receiver in remote.receivers))
		return Fail("The remote modified a locked integrated circuit.", __FILE__, __LINE__)
	board.set_locked(FALSE)
	board.set_on(FALSE)
	if(speaker in player.song.get_instrument_sources())
		return Fail("An off receiver circuit retained its sound source.", __FILE__, __LINE__)
	board.set_on(TRUE)
	receiver.gain.set_input(25)
	if(player.song.get_music_source_gain(speaker) != 0.25)
		return Fail("The receiver did not apply its own stage attenuation.", __FILE__, __LINE__)
	var/obj/item/concert_disk/disk = allocate(/obj/item/concert_disk, run_loc_floor_bottom_left)
	var/datum/track/concert_recording/track = allocate(/datum/track/concert_recording)
	track.song_path = 'sound/items/bikehorn.ogg'
	track.song_length = 60 SECONDS
	disk.tracks += track
	if(!builder.put_in_inactive_hand(disk) || !player.insert_disk(disk, builder) || !player.play_music())
		return Fail("Could not start the stage through its physical player and disk.", __FILE__, __LINE__)
	var/started_at = player.song.playback_started_at
	if(!receiver.playing || !speaker.active)
		return Fail("The installed master did not start its linked speaker.", __FILE__, __LINE__)
	var/sound/near_speaker = player.song.make_file_sound(builder, speaker, 0, 1)
	if(near_speaker.volume != 18.75 || near_speaker.x || near_speaker.y || near_speaker.z)
		return Fail("Non-positional concert audio lost the receiver's own volume setting.", __FILE__, __LINE__)
	master_board.set_on(FALSE)
	if(receiver.playing || (speaker in player.song.get_instrument_sources()))
		return Fail("Powering off the master circuit did not stop external transmission.", __FILE__, __LINE__)
	master_board.set_on(TRUE)
	player_shell.remove_circuit()
	if(player.master_component || receiver.playing || speaker.active || length(player.get_receivers()) || (speaker in player.song.get_instrument_sources()))
		return Fail("Removing the master's circuit retained external stage audio.", __FILE__, __LINE__)
	if(!player.song.playing || !(receiver in remote.receivers))
		return Fail("Detaching the master destroyed its stored links or stopped unrelated local playback.", __FILE__, __LINE__)
	player_shell.attach_circuit(master_board)
	if(!receiver.playing || !(speaker in player.song.get_instrument_sources()) || player.song.playback_started_at != started_at)
		return Fail("Reinstalling the master did not rejoin its stage at the current track position.", __FILE__, __LINE__)
	master_board.remove_component(master)
	if(receiver.playing || (speaker in player.song.get_instrument_sources()))
		return Fail("Removing only the master component retained external sound sources.", __FILE__, __LINE__)
	master_board.add_component_manually(master)
	speaker_shell.remove_circuit()
	if(receiver.playing || speaker.active || speaker.is_synced || (speaker in player.song.get_instrument_sources()))
		return Fail("Removing a receiver circuit retained an active speaker.", __FILE__, __LINE__)
	speaker_shell.attach_circuit(board)
	if(!receiver.playing || !(speaker in player.song.get_instrument_sources()))
		return Fail("Reinstalling the same receiver circuit lost its existing remote link.", __FILE__, __LINE__)
	var/obj/item/circuit_component/concert_master/foreign_master = allocate(/obj/item/circuit_component/concert_master, run_loc_floor_bottom_left)
	foreign_master.attackby(remote, builder, list())
	if(remote.loc != builder)
		return Fail("A different master accepted another component's remote.", __FILE__, __LINE__)
	master.attackby(remote, builder, list())
	if(remote.loc != master)
		return Fail("The remote could not be returned to its owning master component.", __FILE__, __LINE__)
	master.attack_self(builder)
	remote.interact_with_atom(board, builder, list())
	if(!QDELETED(receiver) || length(remote.receivers) || (speaker in player.song.get_instrument_sources()))
		return Fail("Unlinking did not remove the generated receiver and its remote reference.", __FILE__, __LINE__)
	remote.interact_with_atom(board, builder, list())
	receiver = locate() in board.attached_components
	if(!receiver)
		return Fail("Could not relink the receiver circuit.", __FILE__, __LINE__)
	qdel(master)
	if(!QDELETED(remote) || receiver.remote_ref || receiver.playing || speaker.active || speaker.is_synced || (speaker in player.song.get_instrument_sources()))
		return Fail("Deleting a master left its remote, receivers or external audio active.", __FILE__, __LINE__)

/** Speaker/controller conversion must transfer, not duplicate, an installed board. */
/datum/unit_test/concert_equipment_conversion/Run()
	var/mob/living/carbon/human/consistent/builder = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/obj/structure/concertspeaker/speaker = allocate(/obj/structure/concertspeaker, run_loc_floor_bottom_left)
	speaker.set_anchored(TRUE)
	var/datum/component/shell/shell = speaker.GetComponent(/datum/component/shell)
	if(shell.attached_circuit)
		return Fail("A speaker supplied an integrated circuit that was not installed by a player.", __FILE__, __LINE__)
	var/obj/item/integrated_circuit/original_board = allocate(/obj/item/integrated_circuit, run_loc_floor_bottom_left)
	shell.attach_circuit(original_board)
	var/obj/item/concert_master/upgrade = allocate(/obj/item/concert_master, run_loc_floor_bottom_left)
	if(!builder.put_in_active_hand(upgrade))
		return Fail("Could not hold the controller upgrade.", __FILE__, __LINE__)
	speaker.attackby(upgrade, builder, list())
	var/obj/machinery/concert_player/player = locate() in run_loc_floor_bottom_left
	if(!player)
		return Fail("The upgrade did not build a concert player.", __FILE__, __LINE__)
	allocated += player
	shell = player.GetComponent(/datum/component/shell)
	if(shell.attached_circuit != original_board || QDELETED(original_board))
		return Fail("Building the player replaced or deleted the speaker's board.", __FILE__, __LINE__)
	player.set_anchored(FALSE)
	var/obj/item/crowbar/tool = allocate(/obj/item/crowbar, run_loc_floor_bottom_left)
	player.crowbar_act(builder, tool)
	var/obj/structure/concertspeaker/rebuilt = locate() in run_loc_floor_bottom_left
	if(!rebuilt)
		return Fail("Dismantling the player did not restore a speaker.", __FILE__, __LINE__)
	allocated += rebuilt
	shell = rebuilt.GetComponent(/datum/component/shell)
	if(shell.attached_circuit != original_board || QDELETED(original_board))
		return Fail("Dismantling replaced or deleted the original board.", __FILE__, __LINE__)
	var/board_count = 0
	for(var/obj/item/integrated_circuit/board in run_loc_floor_bottom_left.get_all_contents())
		board_count++
	if(board_count != 1)
		return Fail("An equipment conversion duplicated an integrated circuit.", __FILE__, __LINE__)
	var/obj/item/concert_master/returned_module = locate() in run_loc_floor_bottom_left
	if(returned_module)
		allocated += returned_module

/** Five tiles inclusive stays non-positional; mode transitions retain channel and playback time. */
/datum/unit_test/concert_stereo_radius/Run()
	var/obj/machinery/concert_player/player = allocate(/obj/machinery/concert_player, run_loc_floor_bottom_left)
	player.set_is_operational(TRUE)
	var/mob/living/carbon/human/consistent/operator = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/consistent/listener = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/obj/item/concert_disk/disk = allocate(/obj/item/concert_disk, run_loc_floor_bottom_left)
	var/datum/track/concert_recording/track = allocate(/datum/track/concert_recording)
	track.song_path = 'sound/items/bikehorn.ogg'
	track.song_length = 60 SECONDS
	disk.tracks += track
	if(!operator.put_in_active_hand(disk) || !player.insert_disk(disk, operator) || !player.play_music())
		return Fail("Could not start the concert packet fixture.", __FILE__, __LINE__)
	var/datum/song/concert/song = player.song
	song.set_volume(80)
	song.playback_started_at = world.time - 3 SECONDS
	var/turf/origin = get_turf(player)
	var/turf/nearby = locate(origin.x + 5, origin.y, origin.z)
	var/turf/distant = locate(origin.x + 6, origin.y, origin.z)
	if(!nearby || !distant)
		return Fail("The test map has no room for the five/six-tile sound boundary.", __FILE__, __LINE__)
	listener.forceMove(nearby)
	var/sound/packet = song.make_file_sound(listener, player, 5, 1)
	var/channel = packet.channel
	if(packet.x || packet.y || packet.z || packet.pan || packet.volume != 80 || packet.environment != SOUND_ENVIRONMENT_NONE)
		return Fail("At five tiles the actual concert packet was positional or attenuated.", __FILE__, __LINE__)
	packet = song.make_file_sound(listener, player, 5, 1)
	if(!(packet.status & SOUND_UPDATE))
		return Fail("Steady non-positional playback unnecessarily replaced the sound channel.", __FILE__, __LINE__)
	listener.forceMove(distant)
	packet = song.make_file_sound(listener, player, 6, 1)
	if(packet.x != -6 || packet.y || packet.z || packet.volume <= 0 || packet.volume >= 80)
		return Fail("Past five tiles the concert packet did not restore positional attenuation.", __FILE__, __LINE__)
	if((packet.status & SOUND_UPDATE) || packet.offset != 3 || packet.channel != channel)
		return Fail("Entering positional mode did not reuse the current channel at the current time.", __FILE__, __LINE__)
	listener.forceMove(nearby)
	packet = song.make_file_sound(listener, player, 5, 0.5)
	if(packet.x || packet.y || packet.z || packet.volume != 40 || packet.offset != 3 || packet.channel != channel || (packet.status & SOUND_UPDATE))
		return Fail("Returning to non-positional mode lost listener volume, channel or track position.", __FILE__, __LINE__)
	if(song.using_sound_channels != 1)
		return Fail("Crossing the stereo boundary allocated additional sound channels.", __FILE__, __LINE__)
	var/obj/item/instrument/guitar/instrument = allocate(/obj/item/instrument/guitar, run_loc_floor_bottom_left)
	var/sound/instrument_packet = sound('sound/items/bikehorn.ogg')
	if(instrument.song.configure_file_sound(instrument_packet, instrument, nearby, 5, 1) || instrument_packet.x != -5)
		return Fail("The concert-only stereo radius changed ordinary instrument spatial playback.", __FILE__, __LINE__)
	song.stop_playing()



